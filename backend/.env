MONGODB_URI=mongodb://127.0.0.1:27017/event_management
# OU Atlas: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/event_management
JWT_SECRET=change_this_secret_key
JWT_EXPIRES_IN=7d
PORT=5000
NODE_ENV=development
BCRYPT_SALT_ROUNDS=12
BASE_URL=http://localhost:5000
MAX_FILE_SIZE=5242880
ALLOWED_ORIGINS=http://localhost:3000
# QR Code — public-facing base URL embedded in QR codes
FRONTEND_URL=http://localhost:3000

# ─── Email (SMTP) — used to send reservation confirmations + ticket QR codes ──
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="Event Management <no-reply@event-management.local>"

