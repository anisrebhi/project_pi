# ─── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/event_management
# Atlas: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/event_management

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_secret_key_min_32_chars
JWT_EXPIRES_IN=15m              # Access token — short-lived (15 min recommended)
REFRESH_TOKEN_DAYS=30           # Refresh token validity in days

# ─── App ───────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# ─── Security ──────────────────────────────────────────────────────────────────
BCRYPT_SALT_ROUNDS=12
MAX_FILE_SIZE=5242880           # 5 MB in bytes

# ─── QR Code ───────────────────────────────────────────────────────────────────
# Public-facing base URL embedded in QR codes

# ─── Email ─────────────────────────────────────────────────────────────────────
EMAIL_ENABLED=false             # Set to true to send real emails

# SMTP config (used when EMAIL_ENABLED=true)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false              # true for port 465, false for 587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_FROM_NAME=Event Management

# Dev only — Ethereal fake SMTP (used when EMAIL_ENABLED=false)
EMAIL_DEV_USER=
EMAIL_DEV_PASS=
