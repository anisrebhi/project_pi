{
  "info": {
    "name": "Event Management API — Full Test Suite",
    "_postman_id": "event-mgmt-api-v2",
    "description": "Complete collection for testing all API endpoints.\n\n## Setup\n1. Run the seed script first: `node seed.js`\n2. Start server: `npm run dev`\n3. Run **[AUTH] Login as ADMIN** first — the token is saved automatically to `{{token}}` via the Tests script.\n4. Use environment variables: `baseUrl = http://localhost:5000`\n\n## Roles\n- ADMIN: full access\n- ORGANIZER: create/manage events\n- PARTICIPANT: register to events",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "orgToken", "value": "", "type": "string" },
    { "key": "partToken", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "eventId", "value": "", "type": "string" },
    { "key": "reservationId", "value": "", "type": "string" },
    { "key": "reclamationId", "value": "", "type": "string" },
    { "key": "formationId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "🔐 AUTH",
      "item": [
        {
          "name": "[AUTH] Register new user",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Ahmed Test\",\n  \"email\": \"ahmed.test@esprit.tn\",\n  \"password\": \"Test123!\",\n  \"phone\": \"+21612312312\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const data = pm.response.json();",
                  "  pm.collectionVariables.set('token', data.token);",
                  "  pm.collectionVariables.set('userId', data.user._id);",
                  "  console.log('Token saved:', data.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "[AUTH] Login as ADMIN ⭐",
          "request": {
